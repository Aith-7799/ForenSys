// ForenSys — Prisma schema
// Translated 1:1 from the Oracle 11g DDL preserved in docs/oracle-11g-reference.sql
//
// Type mapping applied:
//   VARCHAR2(n)          -> VARCHAR(n)
//   NUMBER(10,2)         -> DECIMAL(10,2)
//   NUMBER               -> INTEGER
//   TIMESTAMP            -> TIMESTAMP(6)
//   *_id VARCHAR2(36)    -> VARCHAR(36), UUID generated by the application (@default(uuid()))
//   CHECK (x IN (...))   -> real CHECK constraints, added inside the init migration
//
// Oracle's `CREATE SEQUENCE seq_audit_id` is preserved as a real Postgres sequence and is
// referenced by CASE_AUDIT_LOG.audit_id below.
//
// Oracle's USER pseudo-column has no Postgres equivalent, so the audit trigger falls back to
// current_setting('app.current_user') (set by the sp_change_case_status function) and then to
// CURRENT_USER. See the init migration and docs/oracle-11g-reference.sql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// OFFICERS — personnel and role-based access control.
model Officer {
  officerId    String @id @default(uuid()) @map("officer_id") @db.VarChar(36)
  badgeNumber  String @unique @map("badge_number") @db.VarChar(50)
  fullName     String @map("full_name") @db.VarChar(150)
  /// CHECK (role IN ('Investigating Officer','Lab Analyst','System Administrator','Judicial Authority'))
  role         String @db.VarChar(50)
  passwordHash String @map("password_hash") @db.VarChar(255)

  leadCases         Case[]       @relation("LeadOfficer")
  releasedTransfers CustodyLog[] @relation("ReleasedBy")
  receivedTransfers CustodyLog[] @relation("ReceivedBy")
  uploadedReports   Report[]

  @@map("officers")
}

/// CASES — the crime report / investigation record.
model Case {
  caseId            String   @id @default(uuid()) @map("case_id") @db.VarChar(36)
  title             String   @db.VarChar(255)
  incidentTimestamp DateTime @map("incident_timestamp") @db.Timestamp(6)
  /// Free-text coordinate pair, e.g. "40.7128,-74.0060" (Oracle stored a VARCHAR2 here too).
  locationPoint     String   @map("location_point") @db.VarChar(100)
  /// DEFAULT 'open', CHECK (status IN ('open','under_investigation','in_court','closed','archived'))
  status            String   @default("open") @db.VarChar(50)
  leadOfficerId     String   @map("lead_officer_id") @db.VarChar(36)

  leadOfficer Officer    @relation("LeadOfficer", fields: [leadOfficerId], references: [officerId], onDelete: Restrict, onUpdate: Cascade)
  evidence    Evidence[]
  reports     Report[]
  newAlerts      DuplicateEvidenceAlert[] @relation("CaseNewAlerts")
  existingAlerts DuplicateEvidenceAlert[] @relation("CaseExistingAlerts")
  similaritiesA  CaseSimilarityCache[]    @relation("CaseSimilarityA")
  similaritiesB  CaseSimilarityCache[]    @relation("CaseSimilarityB")

  // NOTE: CASE_AUDIT_LOG is intentionally NOT a relation here. Oracle declares no foreign key
  // on case_audit_log.case_id, so the audit trail survives a cascading case delete. Query it
  // with prisma.caseAuditLog.findMany({ where: { caseId } }) instead.

  @@index([leadOfficerId])
  @@index([status])
  @@map("cases")
}

/// EVIDENCE — central evidence register (supertype).
model Evidence {
  evidenceId          String   @id @default(uuid()) @map("evidence_id") @db.VarChar(36)
  caseId              String   @map("case_id") @db.VarChar(36)
  /// CHECK (evidence_type IN ('Weapon','Biological','Digital Device','Document','Clothing','Fingerprint','Other'))
  evidenceType        String   @map("evidence_type") @db.VarChar(50)
  collectionTimestamp DateTime @map("collection_timestamp") @db.Timestamp(6)

  case          Case              @relation(fields: [caseId], references: [caseId], onDelete: Cascade, onUpdate: Cascade)
  physical      PhysicalEvidence?
  digital       DigitalEvidence?
  custodyLogs   CustodyLog[]
  reports       Report[]
  newAlerts     DuplicateEvidenceAlert[] @relation("NewEvidenceAlerts")
  matchedAlerts DuplicateEvidenceAlert[] @relation("MatchedEvidenceAlerts")

  @@index([caseId])
  @@map("evidence")
}

/// PHYSICAL_EVIDENCE — subtype.
model PhysicalEvidence {
  evidenceId          String @id @map("evidence_id") @db.VarChar(36)
  storageLockerNumber String @map("storage_locker_number") @db.VarChar(50)
  sealNumber          String @map("seal_number") @db.VarChar(50)
  containerType       String @map("container_type") @db.VarChar(50)

  evidence Evidence @relation(fields: [evidenceId], references: [evidenceId], onDelete: Cascade, onUpdate: Cascade)

  @@map("physical_evidence")
}

/// DIGITAL_EVIDENCE — subtype. CHECK (size_mb > 0) is added in the init migration.
model DigitalEvidence {
  evidenceId     String  @id @map("evidence_id") @db.VarChar(36)
  fileHashSha256 String  @map("file_hash_sha256") @db.VarChar(64)
  mediaType      String  @map("media_type") @db.VarChar(50)
  sizeMb         Decimal @map("size_mb") @db.Decimal(10, 2)
  deviceSerial   String  @map("device_serial") @db.VarChar(50)

  evidence Evidence @relation(fields: [evidenceId], references: [evidenceId], onDelete: Cascade, onUpdate: Cascade)

  @@index([fileHashSha256])
  @@index([deviceSerial])
  @@map("digital_evidence")
}

/// CUSTODY_LOG — immutable chain-of-custody transfer trail.
model CustodyLog {
  logId             String   @id @default(uuid()) @map("log_id") @db.VarChar(36)
  evidenceId        String   @map("evidence_id") @db.VarChar(36)
  releasedById      String   @map("released_by_id") @db.VarChar(36)
  receivedById      String   @map("received_by_id") @db.VarChar(36)
  transferTimestamp DateTime @default(now()) @map("transfer_timestamp") @db.Timestamp(6)
  /// Oracle: mongo_doc_ref VARCHAR2(24). Kept free-text/JSON so it can hold either an external
  /// document-store ObjectId or a REPORTS.report_id pointer to an uploaded lab/witness report.
  mongoDocRef       String?  @map("mongo_doc_ref") @db.Text

  evidence   Evidence @relation(fields: [evidenceId], references: [evidenceId], onDelete: Cascade, onUpdate: Cascade)
  releasedBy Officer  @relation("ReleasedBy", fields: [releasedById], references: [officerId], onDelete: Restrict, onUpdate: Cascade)
  receivedBy Officer  @relation("ReceivedBy", fields: [receivedById], references: [officerId], onDelete: Restrict, onUpdate: Cascade)

  @@index([evidenceId])
  @@index([releasedById])
  @@index([receivedById])
  @@map("custody_log")
}

/// CASE_AUDIT_LOG — written *only* by the trg_audit_case_status trigger, never by app code.
/// Deliberately has no FK to CASES so the audit trail outlives a deleted case (matches Oracle).
model CaseAuditLog {
  auditId         Int       @id @default(dbgenerated("nextval('seq_audit_id'::regclass)")) @map("audit_id") @db.Integer
  caseId          String    @map("case_id") @db.VarChar(36)
  oldStatus       String?   @map("old_status") @db.VarChar(50)
  newStatus       String?   @map("new_status") @db.VarChar(50)
  /// Set by the trigger: app.current_user -> CURRENT_USER fallback (Oracle used USER).
  changedBy       String?   @default(dbgenerated("CURRENT_USER")) @map("changed_by") @db.VarChar(100)
  changeTimestamp DateTime? @default(now()) @map("change_timestamp") @db.Timestamp(6)

  @@index([caseId])
  @@map("case_audit_log")
}

/// REPORTS — uploaded laboratory / witness reports (files on disk, metadata here).
model Report {
  reportId     String   @id @default(uuid()) @map("report_id") @db.VarChar(36)
  /// Attached to a case, an evidence item, or both. CHECK enforces at least one.
  caseId       String?  @map("case_id") @db.VarChar(36)
  evidenceId   String?  @map("evidence_id") @db.VarChar(36)
  /// CHECK (report_type IN ('Laboratory','Witness'))
  reportType   String   @map("report_type") @db.VarChar(50)
  fileName     String   @map("file_name") @db.VarChar(255)
  /// Relative path under UPLOAD_DIR.
  filePath     String   @map("file_path") @db.VarChar(500)
  mimeType     String?  @map("mime_type") @db.VarChar(127)
  sizeBytes    Int?     @map("size_bytes")
  uploadedById String   @map("uploaded_by_id") @db.VarChar(36)
  uploadedAt   DateTime @default(now()) @map("uploaded_at") @db.Timestamp(6)

  case       Case?     @relation(fields: [caseId], references: [caseId], onDelete: Cascade, onUpdate: Cascade)
  evidence   Evidence? @relation(fields: [evidenceId], references: [evidenceId], onDelete: Cascade, onUpdate: Cascade)
  uploadedBy Officer   @relation(fields: [uploadedById], references: [officerId], onDelete: Restrict, onUpdate: Cascade)

  @@index([caseId])
  @@index([evidenceId])
  @@map("reports")
}

/// DUPLICATE_EVIDENCE_ALERT — recorded by trigger when digital evidence matches an existing item in another case.
model DuplicateEvidenceAlert {
  alertId           String   @id @default(uuid()) @map("alert_id") @db.VarChar(36)
  newEvidenceId     String   @map("new_evidence_id") @db.VarChar(36)
  matchedEvidenceId String   @map("matched_evidence_id") @db.VarChar(36)
  matchType         String   @map("match_type") @db.VarChar(50) // 'file_hash_sha256' | 'device_serial'
  caseIdNew         String   @map("case_id_new") @db.VarChar(36)
  caseIdExisting    String   @map("case_id_existing") @db.VarChar(36)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  newEvidence     Evidence @relation("NewEvidenceAlerts", fields: [newEvidenceId], references: [evidenceId], onDelete: Cascade)
  matchedEvidence Evidence @relation("MatchedEvidenceAlerts", fields: [matchedEvidenceId], references: [evidenceId], onDelete: Cascade)
  caseNew         Case     @relation("CaseNewAlerts", fields: [caseIdNew], references: [caseId], onDelete: Cascade)
  caseExisting    Case     @relation("CaseExistingAlerts", fields: [caseIdExisting], references: [caseId], onDelete: Cascade)

  @@index([caseIdNew])
  @@index([caseIdExisting])
  @@index([newEvidenceId])
  @@index([matchedEvidenceId])
  @@map("duplicate_evidence_alerts")
}

/// CASE_SIMILARITY_CACHE — optional precomputed pairwise score cache.
model CaseSimilarityCache {
  cacheId         String   @id @default(uuid()) @map("cache_id") @db.VarChar(36)
  caseIdA         String   @map("case_id_a") @db.VarChar(36)
  caseIdB         String   @map("case_id_b") @db.VarChar(36)
  score           Decimal  @map("score") @db.Decimal(5, 2)
  breakdownJson   String   @map("breakdown_json") @db.Text
  computedAt      DateTime @default(now()) @map("computed_at") @db.Timestamp(6)

  caseA Case @relation("CaseSimilarityA", fields: [caseIdA], references: [caseId], onDelete: Cascade)
  caseB Case @relation("CaseSimilarityB", fields: [caseIdB], references: [caseId], onDelete: Cascade)

  @@unique([caseIdA, caseIdB])
  @@index([caseIdA])
  @@index([caseIdB])
  @@map("case_similarity_cache")
}

