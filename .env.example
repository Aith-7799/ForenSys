# ---- MongoDB (Primary Database) ----------------------------------------
MONGODB_URI="mongodb+srv://<user>:<password>@cluster0.mhr1j39.mongodb.net/forensys?retryWrites=true&w=majority"

# ---- PostgreSQL (Legacy / unused in production) ------------------------
DATABASE_URL="postgresql://forensys:forensys@localhost:5432/forensys?schema=public"

# ---- Auth --------------------------------------------------------------
# Use a long random string in any real deployment.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-too-another-long-random-string"
JWT_REFRESH_EXPIRES_IN="7d"

# ---- Server ------------------------------------------------------------
PORT=4000
# Comma separated list of allowed browser origins for CORS.
# In production, set to your deployed frontend URL e.g. https://forensys.vercel.app
CORS_ORIGIN="http://localhost:5173"

# ---- Uploads -----------------------------------------------------------
# Directory (relative to the server package root) where report files land.
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=25
